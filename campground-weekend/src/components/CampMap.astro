---
import type { CollectionEntry } from 'astro:content';
interface Props { camps: CollectionEntry<'campgrounds'>[] }
const {camps}=Astro.props;
---
<div class="map-explorer" id="explore-map"><div class="map-toolbar"><div><p class="eyebrow">Find your bearings</p><h3>Your next weekend, on the map.</h3><p>Explore researched Wisconsin parks. Select a pin for field notes and operator details.</p></div><button id="map-toggle" aria-expanded="false" aria-controls="map">Explore interactive map ↗</button></div><div class="map-controls" hidden><button id="map-fit" class="secondary">Fit matching places</button><span>Drag to explore · Use + / − to zoom</span></div><div id="map" class="map" hidden aria-label="Interactive map of researched Wisconsin campgrounds"></div><p id="map-status" role="status" class="map-note"></p><p class="map-note">Pins are approximate park locations, not individual campsites or entrance directions. Opening the map loads tiles from OpenStreetMap; the complete campground list remains available.</p></div><script id="camp-data" type="application/json" set:html={JSON.stringify(camps.map(c=>c.data)).replace(/</g,'\u003c')}/>
