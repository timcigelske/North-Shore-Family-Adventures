---
import type { CollectionEntry } from 'astro:content';
import CampMap from './CampMap.astro';import Card from './Card.astro';
interface Props {camps:CollectionEntry<'campgrounds'>[];compact?:boolean}
const {camps,compact=false}=Astro.props;const regions=[...new Set(camps.map(c=>c.data.region))].sort();
---
<section id="explore-map" class:list={['camp-explorer',{'compact-explorer':compact}]} aria-labelledby="explorer-title"><div class="explorer-heading"><div><p class="eyebrow">{camps.length} places. Find your kind of camping.</p><h2 id="explorer-title">Start with a place. Make it a weekend.</h2></div>{compact&&<a href="/campgrounds/">Full campground directory ↗</a>}</div><form id="filters" class="explorer-filters" role="search" aria-label="Filter campgrounds"><div class="primary-filters"><label>Search campgrounds<input id="query" type="search" name="q" placeholder="Name, region, county or amenity" autocomplete="off"/></label><label>Camping style<select name="type"><option value="">All styles</option><option value="tent">Tent</option><option value="rv">RV</option><option value="cabin">Cabin</option><option value="glamping">Glamping</option></select></label><label>Region<select name="region"><option value="">All Wisconsin regions</option>{regions.map(r=><option>{r}</option>)}</select></label></div><div class="filter-actions"><details class="more-filters"><summary>More filters</summary><div class="advanced-filters"><label>Campground type<select name="operator"><option value="">Public & private</option><option value="public">Public parks</option><option value="private">Private campgrounds & resorts</option></select></label><label>Verified amenity<select name="amenity"><option value="">Any amenities</option><option value="showers">Showers</option><option value="electric">Electric sites</option><option value="swimming">Swimming beach / pond</option><option value="playground">Playground</option><option value="pool">Pool</option><option value="wifi">Wi-Fi listed</option></select></label><label>Pets<select name="pets"><option value="">Any / not verified</option><option value="verified">Policy recorded (read restrictions)</option></select></label></div></details><button class="text-button" type="reset">Reset filters</button><p id="result-count" role="status">{camps.length} places to explore</p></div></form><p class="filter-explainer">Filters show facilities confirmed in our research, not live availability. Read each profile for seasonal and accommodation restrictions.</p><div class="explorer-content"><CampMap camps={camps} autoLoad/><div class="explorer-results"><div id="camp-list" class:list={[compact?'explorer-shortlist':'grid']}>{compact?camps.map(({data:c})=><article class="shortlist-card" data-camp-id={c.slug}><p class="eyebrow">{c.region} · {c.operatorType==='private'?'Private':'Public park'}</p><h3><a href={`/campgrounds/${c.slug}/`}>{c.name}</a></h3><p>{c.tradeoff}</p><div class="shortlist-bottom"><span>{Object.entries(c.types).filter(([,v])=>v===true).map(([k])=>k==='rv'?'RV':k).join(' · ')}</span><div class="shortlist-actions">{c.coordinates&&<button class="text-button" data-locate={c.slug} aria-label={`Show ${c.name} on map`}>Show on map</button>}<button class="save" data-save={c.slug} aria-pressed="false" aria-label={`Save ${c.name}`}>♡ Save</button></div></div></article>):camps.map(c=><Card camp={c}/> )}</div><p id="empty" class="empty" hidden>No matching places yet. Try another region or reset your filters.</p></div></div>{compact&&<p class="explorer-directory-link"><a id="full-results" class="button secondary" href="/campgrounds/">Open the full directory ↗</a></p>}</section>
