---
import PartnerLink from './PartnerLink.astro';
const {placement='home-gear'}=Astro.props;
const items=[{id:'rei-tents',url:'https://www.rei.com/c/tents',number:'01',title:'A little room to unwind.',category:'Tents & shelters',copy:'Compare floor dimensions, packed size and weather protection. Leave room for your people and your gear.',cta:'Explore tents at REI'},{id:'rei-sleep',url:'https://www.rei.com/c/sleeping-gear',number:'02',title:'Make a good night of it.',category:'Sleeping gear',copy:'Build a sleep setup for your forecast and comfort needs. Start with a sleeping bag and an insulated pad.',cta:'Explore sleep gear at REI'},{id:'rei-kitchen',url:'https://www.rei.com/c/camp-kitchen',number:'03',title:'Breakfast tastes better here.',category:'Camp kitchen',copy:'Keep your menu simple, then fill the gaps in your cooking kit. Check campground cooking and food-storage rules.',cta:'Explore camp kitchen at REI'}];
---
<section class="section gear-section" aria-label="Camping gear at REI"><div class="section-head"><div><p class="eyebrow">Pack less guesswork</p><h2>A few essentials. A better weekend.</h2></div><a href="/trip-planner/">Start with your packing list ↗</a></div><p class="affiliate-note"><strong>Affiliate links:</strong> We may earn a commission if you buy through these REI links, at no extra cost to you. <a href="/affiliate-disclosure/">How this supports our work</a>.</p><div class="gear-grid">{items.map(item=><article class="gear-card"><span class="gear-number" aria-hidden="true">{item.number}</span><p class="eyebrow">{item.category}</p><h3>{item.title}</h3><p>{item.copy}</p><PartnerLink id={item.id} href={item.url} placement={placement}>{item.cta} ↗</PartnerLink></article>)}</div><p class="map-note">Shop categories, not tested product picks. Borrow what you can and use what you own; current prices, availability and terms are on REI’s site.</p></section>
