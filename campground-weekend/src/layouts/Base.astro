---
import '../styles/global.css';
import {site} from '../config';
import Newsletter from '../components/Newsletter.astro';
const {title,description='Source-backed campground comparisons and practical weekend plans. Starting in Wisconsin.',noindex=false,article=false,published,modified}=Astro.props;
const path=Astro.url.pathname;
const canonical=new URL(path,site.origin).href;
const schema=article?{'@context':'https://schema.org','@type':'Article',headline:title,description,datePublished:published,dateModified:modified,author:{'@type':'Organization',name:site.author},publisher:{'@type':'Organization',name:site.name},mainEntityOfPage:canonical}:{'@context':'https://schema.org','@type':'Organization',name:site.name,url:site.origin,parentOrganization:{'@type':'Organization',name:site.publisher,url:site.publisherUrl}};
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title} | {site.name}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta name="robots" content={!site.production||noindex?'noindex,follow':'index,follow'}/><meta property="og:type" content={article?'article':'website'}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL('/images/social.png',site.origin).href}/><meta name="twitter:card" content="summary_large_image"/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/>{site.verification&&<meta name="google-site-verification" content={site.verification}/ >}{site.adVerification&&/^ca-pub-\d{16}$/.test(site.adClient)&&<meta name="google-adsense-account" content={site.adClient}/>}<script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\u003c')}/>{path!=='/'&&<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:site.name,item:site.origin},{'@type':'ListItem',position:2,name:title,item:canonical}]}).replace(/</g,'\\u003c')}/>}</head>
<body data-production={String(site.production)} data-ga4={site.analytics?site.ga4:''} data-ads-client={site.ads?site.adClient:''} data-cmp={site.cmpUrl}>
<a class="skip" href="#main">Skip to content</a>
{!site.production&&<div class="preview-bar">EDITORIAL PREVIEW <span>·</span> Wisconsin launch collection <span>·</span> Live signup, analytics and ads are off</div>}
<header class="site-header"><a class="brand" href="/" aria-label={`${site.name} home`}>{site.logoUrl?<img src={site.logoUrl} class="brand-logo" width="56" height="56" alt=""/>:<span class="brand-icon" aria-hidden="true">{site.logoMark}</span>}<span>{site.name.split(' ').slice(0,-1).join(' ')}<em>{site.name.split(' ').at(-1)}</em></span></a><nav aria-label="Main navigation"><a href="/campgrounds/">Find a campground</a><a href="/destinations/wisconsin/">Wisconsin</a><a href="/guides/">Field guides</a><a href="/trip-planner/">Plan a trip</a><a class="saved-nav" href="/saved/">♡ Saved</a></nav></header>
<main id="main"><slot /></main>
{path!=='/newsletter/'&&<div class="container"><Newsletter /></div>}
<footer><div class="container footer-grid"><div><a class="footer-brand" href="/">{site.name} {site.logoMark}</a><p>{site.tagline}</p><p>Thoughtful camping. Well-spent weekends.</p></div><nav aria-label="Publication"><a href="/about/">About</a><a href="/authors/editorial-desk/">Our editorial desk</a><a href="/editorial-policy/">Editorial policy</a><a href="/contact/">Contact & corrections</a><a href="/advertise/">Advertise</a></nav><nav aria-label="Policies"><a href="/affiliate-disclosure/">Affiliate disclosure</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><a href="/photo-credits/">Photo credits</a><button class="text-button" data-consent-open>Privacy preferences</button></nav></div><p class="container fine">© 2026 {site.name}. Research-based planning, not live availability. Always verify conditions with the operator.</p></footer>
<dialog id="consent" aria-labelledby="consent-heading"><h2 id="consent-heading">Your privacy choices</h2><p>Saved places and packing lists stay in this browser. Optional analytics help us understand which guides are useful. Analytics stays off until you allow it; ads require a separate certified consent provider before launch.</p><div class="button-row"><button data-consent="granted">Allow analytics</button><button class="secondary" data-consent="denied">Reject analytics</button></div></dialog>
<p id="storage-status" class="storage-status" role="status"></p>
<script>import '../lib/client.ts';</script>
</body></html>
