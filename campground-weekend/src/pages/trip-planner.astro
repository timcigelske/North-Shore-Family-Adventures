---
import NSFAGuides from '../components/NSFAGuides.astro';
import RVshareOffer from '../components/RVshareOffer.astro';
import Base from '../layouts/Base.astro';import Gear from '../components/Gear.astro';import {checklist} from '../lib/planner';
const fields=[['nights','Nights',2],['people','People',4],['lodging','Site / cabin per night · party',0],['rental','RV rental per night · party',0],['delivery','Delivery · party, once',0],['transport','Transport · party, once',0],['fees','Booking / admission / other fees · once',0],['gear','Gear · party, once',0],['food','Food per person per night',0],['taxRate','Illustrative tax on all costs · %',0]];
---
<Base title="Plan your camping weekend" noindex><div class="container"><div class="page-intro"><p class="eyebrow">Leave room for the good part</p><h1>Your weekend, a little more organized.</h1><p class="lede">A practical checklist and a budget you control. Everything stays in this browser; shareable budget links include numbers only.</p><div class="button-row"><button class="secondary" data-print>Print your plan</button><a class="button secondary" href="/saved/">See saved campgrounds</a></div></div><div class="planner-grid"><section class="panel"><h2>Build a realistic budget</h2><p>Enter your own quoted costs or start with an <strong>illustrative</strong> example. These are not live prices. Tax applies to the full subtotal; actual taxes may differ. Refundable deposits are excluded.</p><label for="preset">Illustrative starting point</label><select id="preset"><option value="custom">Enter your own costs</option><option value="tent">Tent weekend example</option><option value="rv">RV with delivery example</option><option value="cabin">Cabin stay example</option></select><form id="cost-form" class="cost-fields">{fields.map(([name,label,value])=><label>{label}<input type="number" name={String(name)} value={value} min={name==='nights'||name==='people'?1:0} max={name==='taxRate'?100:1000000} step={name==='nights'||name==='people'?1:'0.01'} required/></label>)}</form><div class="cost-result" id="cost-result" role="status"></div><div class="button-row"><button id="share-budget">Copy budget link</button><button class="secondary" id="reset-budget">Reset budget</button></div><p class="fine">Lodging and rental are per party per night. Food is per person per night. Delivery, transport, fees and gear are one-time party costs. No names, destinations or packing text are included in the shared link.</p></section><section class="panel"><h2>Pack for your kind of stay</h2><p>Edit the starting list to match your accommodation. Checks and additions save on this browser and device.</p><div class="checklist" id="checklist">{checklist.map((item,i)=><label><input type="checkbox" data-check={String(i)}/><span>{item}</span></label>)}</div><form id="check-add"><label for="new-check">Add an item</label><input id="new-check" maxlength="120" autocomplete="off"/><button type="submit">Add to packing list</button></form><div class="button-row"><button class="secondary" id="check-reset">Reset checklist</button></div><p class="fine">Do not put passwords or sensitive personal information in a saved checklist.</p></section></div><NSFAGuides/><RVshareOffer placement="planner-rv-offer"/><Gear placement="planner-gear"/></div></Base>
