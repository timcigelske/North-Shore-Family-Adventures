---
import Base from '../layouts/Base.astro';import {site} from '../config';
---
<Base title="Contact and campground corrections"><div class="container"><div class="page-intro"><p class="eyebrow">Help make the next weekend better</p><h1>A question, an idea or a fact to check?</h1><p class="lede">Send a correction, ask about advertising or tell us what would make these guides more useful.</p><p>Do not include payment details, student or family records, or sensitive personal information. Email notifications are not yet configured; stored submissions require owner review.</p>{site.contact&&<p>Publisher contact: <a href={`mailto:${site.contact}`}>{site.contact}</a></p>}</div><form class="contact-form section" name="campground-inquiry" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/thanks/" data-inquiry><input type="hidden" name="form-name" value="campground-inquiry"/><label class="honeypot">Leave this blank<input name="bot-field" tabindex="-1" autocomplete="off"/></label><label for="kind">What is this about?</label><select id="kind" name="kind"><option>Campground correction</option><option>Advertising inquiry</option><option>General question</option></select><label for="name">Name (optional)</label><input id="name" name="name" maxlength="100" autocomplete="name"/><label for="email">Your email address</label><input id="email" name="email" type="email" required maxlength="254" autocomplete="email"/><label for="campground">Campground or page (optional)</label><input id="campground" name="campground" maxlength="200"/><label for="message">Message and supporting source links</label><textarea id="message" name="message" maxlength="3000" required></textarea><p class="fine">Submitting shares this inquiry with the publisher through Netlify. See our <a href="/privacy/">privacy information</a>.</p><button>Send inquiry</button><p role="status"></p></form></div></Base>
