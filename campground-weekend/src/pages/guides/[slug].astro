---
import NSFAGuides from '../../components/NSFAGuides.astro';
import {render} from 'astro:content';import Base from '../../layouts/Base.astro';import Newsletter from '../../components/Newsletter.astro';import Card from '../../components/Card.astro';import Ad from '../../components/Ad.astro';import {guides,campgrounds} from '../../lib/content';
export async function getStaticPaths(){return (await guides()).filter(g=>g.data.kind==='guide').map(g=>({params:{slug:g.id},props:{g}}));}
const {g}=Astro.props;const {Content}=await render(g);const related=(await campgrounds()).filter(c=>g.data.campgrounds.includes(c.id));
---
<Base title={g.data.title} description={g.data.description} article published={g.data.published} modified={g.data.modified}><div class="container"><div class="page-intro"><p class="breadcrumbs"><a href="/guides/">Field guides</a> / Wisconsin</p><p class="eyebrow">Practical comparisons · Research-based planning</p><h1>{g.data.title}</h1><p class="lede">{g.data.description}</p><p class="byline">By <a href="/authors/editorial-desk/">Campground Weekend editorial desk</a> · Facts reviewed {g.data.reviewed}</p><div class="utility"><button class="secondary" data-copy>Copy link</button><button class="secondary" data-print>Print guide</button></div></div><Ad placement="guide-intro"/><div class="article-layout"><article class="prose"><Content/><section class="source-list"><h2>Sources and review</h2><p>Desk research and editorial planning advice; no firsthand stay is claimed.</p><ul>{g.data.sources.map(s=><li><a href={s.url}>{s.title}</a> · Accessed {s.accessed}</li>)}</ul><p>First published {g.data.published} · Substantially modified {g.data.modified} · Facts reviewed {g.data.reviewed}.</p></section></article><aside class="side-note"><p class="eyebrow">Put it into practice</p><h2>Make a little room for the weekend.</h2><p>Save your shortlist, edit the packing list and use your own numbers for a realistic budget.</p><a class="button" href="/trip-planner/">Plan your trip ↗</a><a href="/campgrounds/">Compare all 23 campgrounds</a></aside></div><div class="section"><h2>Explore the places in this guide</h2><div class="grid">{related.map(c=><Card camp={c}/>)}</div></div><NSFAGuides doorCounty={g.id==='door-county-camping'}/><Newsletter placement="guide-inline" contentId={g.id}/></div></Base>
