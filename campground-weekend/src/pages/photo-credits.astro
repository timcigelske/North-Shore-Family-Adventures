---
import Base from '../layouts/Base.astro';import {campgrounds} from '../lib/content';const camps=await campgrounds();
---
<Base title="Photo credits and licenses"><div class="container"><div class="page-intro"><h1>Photo credits and licenses</h1><p>Park landscape images are sourced from Wikimedia Commons under the licenses below. They are not original trip photographs and do not show a verified individual campsite. Files may be resized and cropped in the page layout. Original field-note illustrations are created for this publication.</p></div><div class="prose section photo-credits">{camps.filter(c=>c.data.image).map(c=><section><h2>{c.data.name}</h2><p>{c.data.image!.caption}</p><p>{c.data.image!.author} · <a href={c.data.image!.licenseUrl}>{c.data.image!.license}</a> · <a href={c.data.image!.file}>Original file and full attribution</a>. {c.data.image!.modified}</p></section>)}</div></div></Base>
