---
import RVshareOffer from '../../components/RVshareOffer.astro';
import Base from '../../layouts/Base.astro';import Newsletter from '../../components/Newsletter.astro';import PartnerLink from '../../components/PartnerLink.astro';import Ad from '../../components/Ad.astro';import {campgrounds,fact} from '../../lib/content';
export async function getStaticPaths(){return (await campgrounds()).map(c=>({params:{slug:c.data.slug},props:{c:c.data}}));}
const {c}=Astro.props;const dnrBooking=c.bookingUrl.includes('wisconsin.goingtocamp.com');
---
<Base title={`${c.name}: camping field notes`} description={c.description} article published={c.published} modified={c.modified}><div class="container"><div class="page-intro"><div class="breadcrumbs"><a href="/campgrounds/">Campgrounds</a> / <a href="/destinations/wisconsin/">Wisconsin</a> / {c.region}</div><p class="eyebrow">{c.region} · Research-based field notes</p><h1>{c.name}</h1><p class="byline">By <a href="/authors/editorial-desk/">Campground Weekend editorial desk</a> · Facts reviewed {c.reviewed} · <a href="#sources">Sources below</a></p></div><div class="profile-hero"><div><p class="lede">{c.bestFor}.</p><p>{c.accommodationNote}</p><div class="utility"><button class="save secondary" data-save={c.slug} aria-pressed="false">♡ Save campground</button><button class="secondary" data-copy>Copy link</button><button class="secondary" data-print>Print field notes</button></div></div>{c.image?<figure><img src={c.image.src} srcset={`${c.image.src.replace('.webp','-600.webp')} 600w, ${c.image.src} 1200w`} sizes="(max-width:650px) 100vw, 50vw" alt={`${c.name}: ${c.image.caption}`} width={c.image.width} height={c.image.height}/><figcaption>{c.image.caption} · {c.image.author} · <a href={c.image.file}>{c.image.license}</a>. Park landscape; not a photograph of a specific campsite.</figcaption></figure>:<div class="illustration" role="img" aria-label="Original field-note illustration, not a campground photograph">△<span>Research field notes</span></div>}</div><div class="facts"><div class="fact"><b>Verified stays</b>{Object.entries(c.types).filter(([,v])=>v===true).map(([k])=>k==='rv'?'RV':k).join(' · ')}</div><div class="fact"><b>Showers</b>{fact(c.amenities.showers)}{c.amenities.showers&&' · check season'}</div><div class="fact"><b>Electric sites</b>{fact(c.amenities.electric)}</div><div class="fact"><b>Swimming beach</b>{fact(c.amenities.swimming)}</div><div class="fact"><b>Pets</b>{c.petPolicy||'Policy not yet verified; check operator rules'}</div><div class="fact"><b>Pool / Wi-Fi</b>{fact(c.amenities.pool)} / {c.amenities.wifi===true?'Listed; reliability not assessed':fact(c.amenities.wifi)}</div></div><Ad placement="profile-intro"/><div class="article-layout"><article class="prose">{c.sections.map(s=><section><h2>{s.heading}</h2><p>{s.text}</p></section>)}<h2>Nearby activities and a rain plan</h2><ul>{c.nearby.map(n=><li><a href={n.url}>{n.name}</a> — {n.note}</li>)}</ul><h2>Find the right place on the map</h2>{c.coordinates?<><button id="map-toggle" class="secondary" aria-expanded="false">Show location map</button><div id="map" class="map" hidden></div><p class="map-note">{c.coordinates.basis} Location basis: <a href={c.coordinates.source}>coordinate source</a>. Use the operator’s entrance directions.</p><p id="map-status" role="status"></p></>:<p>Coordinates have not yet been verified for this campground. Use the operator’s map and entrance directions linked below.</p>}<h2 id="sources">Research and source notes</h2><p>Desk research, not a firsthand stay or site inspection. Noise, privacy, shade at individual sites, current rates and availability remain unverified unless stated. Accessible facilities should be discussed with the operator for your party’s needs.</p><ul class="source-list">{c.sources.map(s=><li><a href={s.url}>{s.title}</a> · Accessed {s.accessed}. Supports: {s.claims.join('; ')}.</li>)}</ul><p class="fine">Created {c.created} · First published {c.published} · Substantially modified {c.modified} · Facts reviewed {c.reviewed}. A deployment does not update these dates.</p><p><a href={`/contact/#correction-${c.slug}`}>Suggest a correction</a></p></article><aside class="side-note"><p class="eyebrow">Before you book</p><h2>Check the exact site.</h2><p>Confirm dates, dimensions, seasonal facilities, current fees and rules. We show no live availability.</p><PartnerLink id={c.slug} href={c.bookingUrl}>{dnrBooking?'Open official Wisconsin reservations ↗':'Open operator booking information ↗'}</PartnerLink><p class="fine">{dnrBooking?`This opens the statewide booking system. Search for ${c.name} and confirm the exact site.`:'This opens the operator’s own website. Check current rates, availability and terms there.'} This is not an affiliate link.</p><a class="button secondary" href={c.officialUrl}>Operator’s camping details ↗</a><a class="button secondary" href="/trip-planner/">Build your weekend plan</a><h3>Read next</h3>{c.related.map(g=><p><a href={`/guides/${g}/`}>{g.replaceAll('-',' ')}</a></p>)}</aside></div>{c.types.rv===true&&<RVshareOffer placement="profile-rv-offer"/>}<Newsletter placement="profile-footer" contentId={c.slug}/></div><script id="camp-data" type="application/json" set:html={JSON.stringify([c]).replace(/</g,'\u003c')}/></Base>
