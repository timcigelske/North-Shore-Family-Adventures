---
import Base from '../../layouts/Base.astro';import CampMap from '../../components/CampMap.astro';import Card from '../../components/Card.astro';import {campgrounds} from '../../lib/content';
const camps=await campgrounds();const regions=[...new Set(camps.map(c=>c.data.region))];
---
<Base title="Find your Wisconsin campground"><figure class="collection-banner"><img src="/images/camp-morning.webp" width="2172" height="724" alt="Editorial artwork of a peaceful forest lake at sunrise" fetchpriority="high"/><figcaption>AI-generated editorial artwork · An imagined Wisconsin morning</figcaption></figure><div class="container"><div class="page-intro"><p class="eyebrow">The Wisconsin launch collection</p><h1>A place for your kind of weekend.</h1><p class="lede">Compare {camps.length} researched campgrounds. A checked filter means verified availability in our records; unknown is never treated as no.</p></div><div class="directory-layout"><form class="filters" id="filters"><h2>Narrow the search</h2><label>Place or name<input id="query" type="search" name="q" placeholder="Name, county, region"/></label><label>Camping style<select name="type"><option value="">Any verified style</option><option value="tent">Tent</option><option value="rv">RV</option><option value="cabin">Cabin (check eligibility)</option></select></label><label>Region<select name="region"><option value="">All regions</option>{regions.map(r=><option>{r}</option>)}</select></label><label>Verified amenity<select name="amenity"><option value="">Any amenities</option><option value="showers">Showers (may be seasonal)</option><option value="electric">Electric sites</option><option value="swimming">Swimming beach</option><option value="playground">Playground</option></select></label><label>Pets<select name="pets"><option value="">Any / not verified</option><option value="verified">Policy recorded (read restrictions)</option></select></label><button class="secondary" type="reset">Reset filters</button></form><div><div class="results-header"><p id="result-count" role="status">{camps.length} places to explore</p></div><CampMap camps={camps}/><div class="grid" id="camp-list">{camps.map(c=><Card camp={c}/>)}</div><p class="empty" id="empty" hidden>No places match those choices yet. Try another region or reset the filters. Our collection does not cover every Wisconsin campground.</p></div></div></div></Base>
