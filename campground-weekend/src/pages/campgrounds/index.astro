---
import Base from '../../layouts/Base.astro';import Explorer from '../../components/Explorer.astro';import {campgrounds} from '../../lib/content';
const camps=await campgrounds();
---
<Base title="Find your Wisconsin campground" description={`Search and compare ${camps.length} Wisconsin campgrounds, state parks and private resorts by camping style, region and verified amenities.`}><div class="container"><div class="directory-intro"><p class="eyebrow">Wisconsin, a weekend at a time</p><h1>Find your next great campsite.</h1></div><Explorer camps={camps}/><figure class="directory-photo"><img src="/images/camp-tents-unsplash.webp" width="1800" height="1196" alt="Three tents on a grassy lakeshore beside a forest" loading="lazy"/><figcaption>Camping inspiration · Photo by <a href="https://unsplash.com/photos/three-tents-set-up-on-a-grassy-lakeside-3lbaVlu4P5E">Adem Percem / Unsplash</a>. Not a photograph of a campground listed here.</figcaption></figure></div></Base>
