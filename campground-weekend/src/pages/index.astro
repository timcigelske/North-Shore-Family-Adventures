---
import RVshareOffer from '../components/RVshareOffer.astro';
import Base from '../layouts/Base.astro';import Gear from '../components/Gear.astro';import Explorer from '../components/Explorer.astro';import Sponsor from '../components/Sponsor.astro';import Card from '../components/Card.astro';import {campgrounds,guides} from '../lib/content';
const camps=await campgrounds(), articles=(await guides()).filter(g=>g.data.kind==='guide');
const featured=['peninsula','kohlerandrae','mirrorlake'].map(id=>camps.find(c=>c.data.slug===id)).filter(Boolean);
const destinations=[{name:'Door County',copy:'From bayside base camps to carry-in adventures.',slug:'door-county',image:camps.find(c=>c.id==='peninsula')?.data.image},{name:'Lake Michigan shore',copy:'Woods, dunes and a weekend by the water.',slug:'lake-michigan-shore',image:camps.find(c=>c.id==='kohlerandrae')?.data.image},{name:'Dells & Baraboo',copy:'Choose the right base for a park-filled weekend.',slug:'dells-baraboo',image:camps.find(c=>c.id==='mirrorlake')?.data.image}];
---
<Base title="Good camping. Great weekends."><section class="panorama-hero discovery-hero"><picture><source media="(max-width:650px)" srcset="/images/camp-lake-unsplash-900.webp"/><img src="/images/camp-lake-unsplash.webp" width="1800" height="1000" alt="A green camping tent among pine trees beside a lake" fetchpriority="high"/></picture><div class="panorama-shade"></div><div class="container panorama-copy"><p class="eyebrow">Wisconsin field notes · More weekends outside</p><h1>Less wondering.<br/>More <em>wandering.</em></h1><p>Find a campground that fits your kind of weekend.<br class="desktop-break"/> Useful details. Fresh inspiration. A little adventure.</p></div><span class="art-caption">Camping inspiration · Photo by <a href="https://unsplash.com/photos/tent-set-up-by-a-lake-with-pine-trees-OHi9hrdC7N0">Hanna Lazar / Unsplash</a></span></section><div class="container"><Explorer camps={camps} compact/><RVshareOffer placement="home-rv-offer"/><div class="intro-strip"><div><b>{camps.length} researched places</b>Wisconsin is our starting point.</div><div><b>Find your kind of weekend</b>Places to explore. Plans to make.</div><div><b>Your way to camp</b>Tents, RVs and carefully explained cabins.</div></div>
<section class="section"><div class="section-head"><div><p class="eyebrow">Start with a place</p><h2>Where will the weekend take you?</h2></div><a href="/destinations/wisconsin/">Explore Wisconsin ↗</a></div><div class="destination-grid">{destinations.map(d=><a class="destination" href={`/destinations/wisconsin/${d.slug}/`}>{d.image&&<img src={d.image.src} alt="" width={1200} height={800} loading="lazy"/>}<div><p>WISCONSIN</p><h3>{d.name} ↗</h3><p>{d.copy}</p></div></a>)}</div></section>
<Sponsor id="homepage-feature"/><section class="section"><div class="section-head"><div><p class="eyebrow">Get to know your options</p><h2>A few places to begin.</h2></div><a href="/campgrounds/">All campgrounds ↗</a></div><div class="grid">{featured.map(c=><Card camp={c}/>)}</div></section>
<section class="editor-note"><div><p class="eyebrow">The difference is in the details</p><h2>A lake view isn’t a swimming beach.</h2></div><div><p>And “cabin” doesn’t always mean a private bathroom. We read the operator’s information, explain what it means for your trip, and say when something is still unknown.</p><a href="/editorial-policy/">How our field notes work ↗</a></div></section>
<section class="section"><div class="section-head"><div><p class="eyebrow">Less guesswork. Better plans.</p><h2>Read before you roll out.</h2></div><a href="/guides/">All field guides ↗</a></div><div class="guide-list">{articles.slice(0,4).map((g,i)=><a class="guide-card" href={`/guides/${g.id}/`}><span class="number">0{i+1}</span><div><h3>{g.data.title}</h3><p>{g.data.description}</p></div></a>)}</div></section>
<Gear/><section class="editor-note"><div><p class="eyebrow">Make it your weekend</p><h2>A packing list.<br/>A realistic budget.<br/>A plan you can print.</h2></div><div><p>Save a few places, tick off the essentials and build a trip estimate with your own costs. Your saved places and checklist stay on this device.</p><a class="button" href="/trip-planner/">Open the trip planner ↗</a></div></section></div></Base>
