---
import Base from '../../layouts/Base.astro';import Card from '../../components/Card.astro';import {campgrounds} from '../../lib/content';
export function getStaticPaths(){return [{params:{slug:'wisconsin'},props:{name:'Wisconsin',region:null,description:'Our first collection: 23 researched campgrounds, practical comparisons and a plan for your next weekend.'}},{params:{slug:'wisconsin/door-county'},props:{name:'Door County',region:'Door County',description:'Decide between a car-accessible base, a backpacking trip and a vehicle-free island stay. Each choice changes how you pack.'}},{params:{slug:'wisconsin/lake-michigan-shore'},props:{name:'Lake Michigan shore',region:'Lake Michigan shore',description:'Compare wooded and dune-side camping with realistic expectations about beach access, lake views and seasonal facilities.'}},{params:{slug:'wisconsin/dells-baraboo'},props:{name:'Dells & Baraboo',region:'Dells & Baraboo',description:'Compare Devil’s Lake, Mirror Lake and summer camping at Rocky Arbor. Choose your campground around your actual weekend plans.'}}];}
const {name,region,description}=Astro.props;const camps=(await campgrounds()).filter(c=>!region||c.data.region===region);
const guide=region==='Door County'?'door-county-camping':region==='Dells & Baraboo'?'devils-lake-vs-mirror-lake':'campgrounds-near-milwaukee';
---
<Base title={`Camping in ${name}`} description={description}><div class="container"><div class="page-intro"><p class="eyebrow">Start with a place · Wisconsin</p><h1>A weekend in {name}.</h1><p class="lede">{description}</p><p>We distinguish published facilities from unknown details, and planning recommendations from personal experience. These are curated launch records, not a complete directory or live availability feed.</p><a href={`/guides/${guide}/`}>Read the regional comparison ↗</a></div><section class="section"><h2>Choose the camping setup first</h2><p style="max-width:760px">A drive-in campsite keeps the car in the plan. A walk-in site changes the carrying load. A cabin may have shared facilities or eligibility rules. Open each profile for the accommodation details, the meaningful tradeoff and the official reservation route. Save a shortlist, then use the planner to compare your complete trip costs.</p><div class="grid">{camps.map(c=><Card camp={c}/>)}</div></section></div></Base>
