{
  "name": "campground-weekend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && node scripts/postbuild.mjs",
    "check": "astro check",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "qa": "pnpm check && pnpm test && pnpm build && node scripts/audit.mjs"
  },
  "dependencies": {
    "astro": "7.4.2",
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/leaflet": "1.9.22",
    "@types/node": "^24.19.2",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.25.0"
}
